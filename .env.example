# Run through Google Antigravity (no separate GEMINI_API_KEY needed when true)
USE_ANTIGRAVITY=true

# Google Sheets Common Questions ID or URL (synced via Antigravity gsheets/gdrive)
COMMON_QUESTIONS_SHEET_ID=your_google_sheet_id_here

# Optional Fallback: Google Gemini API Key (only needed if running outside Antigravity)
GEMINI_API_KEY=

# Gemini Models
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Workday Account Signup Defaults
APPLICANT_EMAIL=your.email@example.com
# Master password matching Workday's strict rules (8+ chars, upper, lower, number, special char)
# Used by the Credential Vault when creating new per-company Workday accounts
WORKDAY_DEFAULT_PASSWORD=WorkdayApply#2026!

# Execution & Fallback Settings
MAX_RECRUITER_REVISIONS=3
INITIAL_HEADLESS=true
PAUSE_BEFORE_FINAL_SUBMIT=false
